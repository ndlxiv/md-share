---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Shared Markdown" description="A shared Markdown document.">
  <main class="container view-shell">
    <form id="password-form" class="panel" hidden>
      <p class="eyebrow">Protected share</p>
      <label>
        This share is password protected
        <input id="view-password" type="password" placeholder="Enter password" autocomplete="off" />
      </label>
      <button class="button primary" type="submit">Unlock</button>
      <p id="password-error" class="status" role="status"></p>
    </form>
    <article id="markdown-preview" class="prose muted-preview">Loading…</article>
  </main>
  <script is:inline type="module" src="/viewer.js"></script>
</BaseLayout>
