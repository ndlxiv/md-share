---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Admin" description="Upload and edit Markdown shares from the browser.">
  <main class="container admin-shell">
    <section class="hero compact">
      <div class="eyebrow">Admin UI</div>
      <h1>Upload & edit Markdown without redeploying.</h1>
      <p class="lead">Bài viết được lưu trong Cloudflare D1. Lưu xong là link public cập nhật ngay.</p>
    </section>

    <section class="admin-grid">
      <form id="editor" class="panel editor-panel">
        <label>
          Admin token
          <input id="token" name="token" type="password" autocomplete="current-password" placeholder="Dán token admin" required />
        </label>
        <div class="row">
          <label>
            Slug URL
            <input id="slug" name="slug" placeholder="hello-world" required />
          </label>
          <label>
            Public
            <select id="public" name="public">
              <option value="true">Public</option>
              <option value="false">Hidden</option>
            </select>
          </label>
        </div>
        <label>
          Title
          <input id="title" name="title" placeholder="Tên bài" required />
        </label>
        <label>
          Description
          <input id="description" name="description" placeholder="Mô tả ngắn" />
        </label>
        <label>
          Upload .md file
          <input id="file" type="file" accept=".md,.markdown,text/markdown,text/plain" />
        </label>
        <label>
          Markdown content
          <textarea id="content" name="content" rows="18" placeholder="# Heading\n\nNội dung markdown..."></textarea>
        </label>
        <div class="actions">
          <button class="button primary" type="submit">Save</button>
          <button class="button" id="new-doc" type="button">New</button>
          <button class="button danger" id="delete-doc" type="button">Delete</button>
        </div>
        <p id="status" class="status" role="status"></p>
      </form>

      <aside class="panel">
        <div class="list-head">
          <h2>Documents</h2>
          <button class="button" id="refresh" type="button">Refresh</button>
        </div>
        <div id="docs" class="doc-list">Loading…</div>
      </aside>
    </section>
  </main>

  <!-- Admin script uses localStorage to remember token. -->
  <script is:inline src="/admin.js" defer></script>
</BaseLayout>
