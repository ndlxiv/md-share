---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "../components/icons/Icon";
---
<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <section class="narrow-shell">
    <div class="card notice-card">
      <div class="notice-icon"><Icon name="file-x" /></div>
      <h1>Page not found</h1>
      <p class="meta">The page you are looking for does not exist.</p>
      <a class="button primary wide" href="/"><Icon name="plus" /><span>Create a new share</span></a>
    </div>
  </section>
</BaseLayout>
