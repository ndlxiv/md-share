---
import BaseLayout from "../layouts/BaseLayout.astro";

const modules = import.meta.glob("../content/shares/*.{md,mdx}", { eager: true });
const fallbackShares = Object.entries(modules)
  .map(([path, mod]: [string, any]) => {
    const slug = path.split("/").pop()?.replace(/\.(md|mdx)$/i, "") ?? "";
    return { slug, frontmatter: mod.frontmatter ?? {} };
  })
  .filter((share) => share.frontmatter.public !== false)
  .sort((a, b) => String(b.frontmatter.createdAt ?? "").localeCompare(String(a.frontmatter.createdAt ?? "")));
---
<BaseLayout title="MD Share" description="Upload, edit, and share Markdown as public pages.">
  <main class="container">
    <section class="hero">
      <div class="eyebrow">Editable Markdown sharing</div>
      <h1>Upload `.md` files and edit them from the web.</h1>
      <p class="lead">
        Markdown is stored in Cloudflare D1 and served through Pages Functions, so saving in the Admin UI updates public links immediately — no manual deploy.
      </p>
      <div class="actions">
        <a class="button primary" href="/admin/">Open Admin</a>
      </div>
    </section>

    <section id="dynamic-shares" class="share-grid" aria-label="Published markdown shares">
      {fallbackShares.map(({ slug, frontmatter }) => (
        <a class="card" href={`/p/${slug}/`}>
          <h2>{frontmatter.title ?? slug}</h2>
          {frontmatter.description && <p>{frontmatter.description}</p>}
          <span class="meta">Open /p/{slug}</span>
        </a>
      ))}
    </section>
    <p id="empty" class="empty" hidden>No public Markdown files yet. Open Admin to upload one.</p>
  </main>

  <script is:inline src="/index.js" defer></script>
</BaseLayout>
