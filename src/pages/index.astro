---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="MDShare" description="Paste Markdown and create a public share link instantly.">
  <main class="od-shell" data-page="create-share">
    <section class="od-hero" aria-label="Create markdown share">
      <div class="od-kicker">Open Design inspired · local-first markdown sharing</div>
      <div class="od-hero-grid">
        <div class="od-copy">
          <p class="eyebrow">Create New Share</p>
          <h1>MDShare</h1>
          <p class="lead">Drop a Markdown file or write directly. Preview on the right, ship a clean public link in one click.</p>
        </div>
        <div class="od-hero-actions">
          <span class="od-status">README.md</span>
          <button id="create-share" class="button primary od-create-top" type="button" disabled>Create Share</button>
        </div>
      </div>
    </section>

    <section class="od-workspace" aria-label="Markdown sharing workspace">
      <aside class="file-panel od-card" aria-label="Files">
        <div class="panel-title">
          <span>File</span>
        </div>
        <button class="file-item active" type="button">
          <span>README.md</span>
          <small>Current document</small>
        </button>
        <label class="drop-zone">
          <input id="file-input" type="file" accept=".md,.markdown,.txt,text/markdown,text/plain" hidden />
          <span>Drop .md files here</span>
          <small>or tap to choose file</small>
        </label>
      </aside>

      <section class="editor-panel od-card" aria-label="Write markdown">
        <div class="panel-title">
          <span>Write</span>
          <span class="od-pill">Markdown</span>
        </div>
        <textarea id="markdown-input" placeholder="Enter your markdown here..." spellcheck="false"></textarea>
      </section>

      <section class="preview-panel od-card" aria-label="Preview markdown">
        <div class="panel-title">
          <span>Preview</span>
          <span class="od-pill muted">Live</span>
        </div>
        <article id="markdown-preview" class="prose muted-preview">Nothing to preview</article>
      </section>

      <aside class="options-panel od-card" aria-label="Share options">
        <label class="switch-row">
          <span>Password protect</span>
          <input id="password-protect" type="checkbox" />
        </label>
        <div id="password-row" class="field-row" hidden>
          <label for="share-password">Password</label>
          <input id="share-password" type="password" placeholder="Optional password" />
        </div>
        <label class="field-row" for="expiration">
          <span>Expiration</span>
          <select id="expiration">
            <option value="1h">1 hour</option>
            <option value="1d">1 day</option>
            <option value="7d">7 days</option>
            <option value="30d" selected>30 days</option>
            <option value="never">Never</option>
          </select>
        </label>
        <p class="meta">Share will be automatically deleted after the selected time.</p>
      </aside>

      <div class="mobile-action-bar" aria-label="Create share action">
        <button id="create-share-mobile" class="button primary" type="button" disabled>Create Share</button>
      </div>
    </section>

    <section id="created-panel" class="created-panel od-card" hidden aria-live="polite">
      <div class="created-head">
        <div class="created-badge" aria-hidden="true">✓</div>
        <h2>Share created!</h2>
        <p class="meta">Your markdown is live — copy the link and share it anywhere.</p>
      </div>
      <div class="created-link">
        <input id="share-url" readonly aria-label="Share link" />
        <button id="copy-share-url" class="button primary" type="button">📋 Copy link</button>
      </div>
      <div class="created-actions">
        <a id="open-share-url" class="button" target="_blank" rel="noreferrer">🔗 Open</a>
        <button id="create-another" class="button" type="button">＋ Create another</button>
      </div>
    </section>

  </main>
  <script is:inline type="module" src="/share.js"></script>
</BaseLayout>
