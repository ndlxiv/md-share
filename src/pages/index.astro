---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="MDShare" description="Paste Markdown and create a public share link instantly.">
  <main class="simple-shell" data-page="create-share">
    <section class="simple-hero" aria-label="Create markdown share">
      <div>
        <p class="eyebrow">Create New Share</p>
        <h1>MDShare</h1>
      </div>
      <button id="create-share" class="button primary" type="button" disabled>Create Share</button>
    </section>

    <section class="share-workspace">
      <aside class="file-panel" aria-label="Files">
        <div class="panel-title">
          <span>Files</span>
          <button class="icon-button" id="add-file" type="button" aria-label="Add file">+</button>
        </div>
        <button class="file-item active" type="button">README.md</button>
        <p class="meta">1/10 files</p>
        <label class="drop-zone">
          <input id="file-input" type="file" accept=".md,.markdown,.txt,text/markdown,text/plain" hidden />
          <span>Drop .md files here</span>
        </label>
      </aside>

      <section class="editor-panel" aria-label="Write markdown">
        <div class="panel-title">Write</div>
        <textarea id="markdown-input" placeholder="Enter your markdown here..." spellcheck="false"></textarea>
      </section>

      <section class="preview-panel" aria-label="Preview markdown">
        <div class="panel-title">Preview</div>
        <article id="markdown-preview" class="prose muted-preview">Nothing to preview</article>
      </section>

      <aside class="options-panel" aria-label="Share options">
        <button id="create-share-secondary" class="button primary wide" type="button" disabled>Create Share</button>
        <label class="switch-row">
          <span>Password protect</span>
          <input id="password-protect" type="checkbox" />
        </label>
        <div id="password-row" class="field-row" hidden>
          <label for="share-password">Password</label>
          <input id="share-password" type="password" placeholder="Optional password" />
        </div>
        <label class="field-row" for="expiration">
          <span>Expiration</span>
          <select id="expiration">
            <option value="1h">1 hour</option>
            <option value="1d">1 day</option>
            <option value="7d">7 days</option>
            <option value="30d" selected>30 days</option>
            <option value="never">Never</option>
          </select>
        </label>
        <p class="meta">Share will be automatically deleted after the selected time.</p>
        <label class="switch-row">
          <span>Burn after reading</span>
          <input id="burn-after-reading" type="checkbox" />
        </label>
      </aside>
    </section>

    <section id="created-panel" class="created-panel" hidden aria-live="polite">
      <h2>Share Created!</h2>
      <p>Your markdown is ready to share.</p>
      <label class="field-row">
        <span>Share URL</span>
        <input id="share-url" readonly />
      </label>
      <div class="actions">
        <button id="copy-share-url" class="button" type="button">Copy link</button>
        <a id="open-share-url" class="button" target="_blank" rel="noreferrer">Open share</a>
        <button id="create-another" class="button" type="button">Create Another Share</button>
      </div>
    </section>
  </main>
  <script is:inline src="/share.js" defer></script>
</BaseLayout>
