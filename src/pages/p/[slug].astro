---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  const modules = import.meta.glob("../../content/shares/*.{md,mdx}", { eager: true });
  return Object.entries(modules)
    .map(([path, mod]: [string, any]) => {
      const slug = path.split("/").pop()?.replace(/\.(md|mdx)$/i, "") ?? "";
      return { params: { slug }, props: { post: mod, slug } };
    })
    .filter(({ props }) => props.post.frontmatter?.public !== false);
}

const { post, slug } = Astro.props;
const { Content } = post;
const title = post.frontmatter?.title ?? slug;
const description = post.frontmatter?.description ?? `Markdown share: ${title}`;
const createdAt = post.frontmatter?.createdAt ? new Date(post.frontmatter.createdAt).toLocaleDateString("vi-VN") : null;
---
<BaseLayout title={title} description={description}>
  <main class="article-shell">
    <header class="article-header">
      <p class="article-meta">{createdAt ? `Published ${createdAt}` : "Markdown share"}</p>
      <h1>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <div class="actions">
        <button class="button" id="copy-link" type="button">Copy link</button>
        <a class="button" href="/">Back to all shares</a>
      </div>
    </header>
    <article class="prose">
      <Content />
    </article>
  </main>
  <script>
    const button = document.getElementById("copy-link");
    button?.addEventListener("click", async () => {
      await navigator.clipboard.writeText(window.location.href);
      const original = button.textContent;
      button.textContent = "Copied";
      window.setTimeout(() => (button.textContent = original), 1400);
    });
  </script>
</BaseLayout>
