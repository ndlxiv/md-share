{
  "name": "md-share",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test",
    "db:migrate": "wrangler d1 execute md-share-db --remote --file=migrations/0001_create_shares.sql",
    "db:migrate:local": "wrangler d1 execute md-share-db --local --file=migrations/0001_create_shares.sql",
    "deploy:cloudflare": "npm run build && npx wrangler pages deploy dist --project-name md-share"
  },
  "dependencies": {
    "@astrojs/check": "latest",
    "@astrojs/mdx": "latest",
    "@astrojs/sitemap": "latest",
    "astro": "latest",
    "marked": "^18.0.4",
    "typescript": "latest"
  }
}
